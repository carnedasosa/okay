# Public URL of the site (no trailing slash): used for canonical, sitemap,
# OpenGraph and schema.org. Replace with the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.okaybari.it

# Draft markers: small yellow dots next to data still to be confirmed with
# the venue (phone, hours, prices) and the photo briefs on placeholders.
# Set to "false" once the owner has verified src/data/*.
NEXT_PUBLIC_DRAFT_MARKERS=true
